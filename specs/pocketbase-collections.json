[
  {
    "name": "users",
    "type": "auth",
    "comment": "PB auth duy nhat. Login bang username (staff username / customer SDT). SQLite roles -> select field role; password bcrypt SQLite KHONG mang sang, user dat lai mat khau.",
    "fields": [
      { "name": "username", "type": "text", "required": true, "unique": true, "min": 3, "max": 150, "comment": "username = SDT doi voi customer (PB built-in username login)" },
      { "name": "email", "type": "email", "required": false, "unique": false, "comment": "de trong optional; emailVisibility=false" },
      { "name": "emailVisibility", "type": "bool", "required": false },
      { "name": "verified", "type": "bool", "required": false },
      { "name": "full_name", "type": "text", "required": true, "max": 200 },
      { "name": "phone", "type": "text", "required": false, "unique": true, "max": 20, "comment": "customer bat buoc o app; staff cu NULL duoc; UNIQUE (NULL distinct theo PB)" },
      { "name": "role", "type": "select", "required": true, "values": ["admin", "staff", "customer"], "maxSelect": 1, "comment": "thay bang roles SQLite (admin/staff/customer). guest khong co row, khong login" },
      { "name": "is_active", "type": "bool", "required": false, "comment": "SQLite 0/1 -> PB bool (default true)" },
      { "name": "permissions", "type": "json", "required": false, "maxSize": 2000, "comment": "JSON 5 flags {checkin,pass_sale,report_self,profile_self,reservation} 0|1; NULL = full staff cu" },
      { "name": "address", "type": "text", "required": false, "max": 255 },
      { "name": "start_date", "type": "date", "required": false, "comment": "YYYY-MM-DD ngay vao lam" },
      { "name": "notes", "type": "text", "required": false, "max": 500, "comment": "ADMIN-ONLY: khong tra ve cho staff (enforce o API rule / hook)" }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_users_username ON `users` (username)", "CREATE UNIQUE INDEX idx_users_phone ON `users` (phone)"],
    "listRule": "@request.auth.role = 'admin'",
    "viewRule": "@request.auth.id = id || @request.auth.role = 'admin'",
    "createRule": "",
    "updateRule": "@request.auth.id = id || @request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'",
    "options": { "allowUsernameAuth": true, "allowEmailAuth": false, "requireEmail": false, "emailVisibilityDefault": false, "minPasswordLength": 6 }
  },
  {
    "name": "zones",
    "type": "base",
    "comment": "<- parking_zones (code UNIQUE, capacity>0, gia VND)",
    "fields": [
      { "name": "code", "type": "text", "required": true, "unique": true, "max": 10, "comment": "vd A/B/C" },
      { "name": "name", "type": "text", "required": true, "max": 200 },
      { "name": "vehicle_type_allowed", "type": "select", "required": true, "values": ["car", "motorbike", "both"], "maxSelect": 1 },
      { "name": "capacity", "type": "number", "required": true, "min": 1, "max": 2000 },
      { "name": "price_per_hour", "type": "number", "required": true, "min": 0 },
      { "name": "price_per_day", "type": "number", "required": true, "min": 0 },
      { "name": "is_active", "type": "bool", "required": false }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_zones_code ON zones (code)"],
    "listRule": "",
    "viewRule": "",
    "createRule": "@request.auth.role = 'admin'",
    "updateRule": "@request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "spots",
    "type": "base",
    "comment": "<- parking_spots (UNIQUE zone+spot_number). status do app cap nhat khi check-in/out.",
    "fields": [
      { "name": "zone", "type": "relation", "required": true, "collectionId": "zones", "cascadeDelete": true, "maxSelect": 1 },
      { "name": "spot_number", "type": "text", "required": true, "max": 20, "comment": "vd A-01" },
      { "name": "status", "type": "select", "required": true, "values": ["available", "occupied", "reserved", "maintenance"], "maxSelect": 1 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_spots_zone_number ON spots (zone, spot_number)", "CREATE INDEX idx_spots_zone_status ON spots (zone, status)"],
    "listRule": "",
    "viewRule": "",
    "createRule": "@request.auth.role = 'admin'",
    "updateRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "vehicles",
    "type": "base",
    "comment": "<- vehicles (license_plate UNIQUE, app chuan hoa UPPERCASE)",
    "fields": [
      { "name": "license_plate", "type": "text", "required": true, "unique": true, "min": 2, "max": 20 },
      { "name": "vehicle_type", "type": "select", "required": true, "values": ["car", "motorbike"], "maxSelect": 1 },
      { "name": "owner_name", "type": "text", "required": false, "max": 200 },
      { "name": "owner_phone", "type": "text", "required": false, "max": 20 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_vehicles_plate ON vehicles (license_plate)"],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "updateRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "passes",
    "type": "base",
    "comment": "<- monthly_passes (pass_code UNIQUE; zone NULL = moi zone; pending=khach tu dang ky). CHECK end>start -> validate o rule/hook + app.",
    "fields": [
      { "name": "pass_code", "type": "text", "required": true, "unique": true, "max": 30 },
      { "name": "vehicle", "type": "relation", "required": true, "collectionId": "vehicles", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "zone", "type": "relation", "required": false, "collectionId": "zones", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "customer_name", "type": "text", "required": true, "min": 1, "max": 200 },
      { "name": "customer_phone", "type": "text", "required": true, "max": 20 },
      { "name": "start_date", "type": "date", "required": true },
      { "name": "end_date", "type": "date", "required": true },
      { "name": "price", "type": "number", "required": true, "min": 0 },
      { "name": "status", "type": "select", "required": true, "values": ["pending", "active", "expired", "cancelled", "suspended"], "maxSelect": 1 },
      { "name": "created_by", "type": "relation", "required": false, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_pass_code ON passes (pass_code)", "CREATE INDEX idx_pass_vehicle ON passes (vehicle)", "CREATE INDEX idx_pass_status ON passes (status)"],
    "listRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "viewRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "sessions",
    "type": "base",
    "comment": "<- parking_sessions (ticket_code UNIQUE; parked => check_out NULL; total_fee=NULL khi dang do; ve thang => total 0). CHECK out>in -> app + hook.",
    "fields": [
      { "name": "ticket_code", "type": "text", "required": true, "unique": true, "max": 30 },
      { "name": "vehicle", "type": "relation", "required": true, "collectionId": "vehicles", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "spot", "type": "relation", "required": false, "collectionId": "spots", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "zone", "type": "relation", "required": true, "collectionId": "zones", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "monthly_pass", "type": "relation", "required": false, "collectionId": "passes", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "check_in_at", "type": "date", "required": true },
      { "name": "check_out_at", "type": "date", "required": false },
      { "name": "status", "type": "select", "required": true, "values": ["parked", "completed", "cancelled"], "maxSelect": 1 },
      { "name": "hourly_rate_applied", "type": "number", "required": true, "min": 0 },
      { "name": "daily_rate_applied", "type": "number", "required": true, "min": 0 },
      { "name": "total_fee", "type": "number", "required": false, "min": 0 },
      { "name": "discount_amount", "type": "number", "required": false, "min": 0 },
      { "name": "created_by", "type": "relation", "required": false, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "closed_by", "type": "relation", "required": false, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_sessions_ticket ON sessions (ticket_code)", "CREATE INDEX idx_sessions_vehicle ON sessions (vehicle)", "CREATE INDEX idx_sessions_zone ON sessions (zone)", "CREATE INDEX idx_sessions_status ON sessions (status)", "CREATE INDEX idx_sessions_checkin ON sessions (check_in_at)"],
    "listRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "viewRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "createRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "updateRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "payments",
    "type": "base",
    "comment": "<- payments append-only (KHONG update/delete tu app; sua sai = tao payment dieu chinh moi). CHECK 1-trong-2 NOT NULL -> app + hook.",
    "fields": [
      { "name": "session", "type": "relation", "required": false, "collectionId": "sessions", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "monthly_pass", "type": "relation", "required": false, "collectionId": "passes", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "amount", "type": "number", "required": true, "min": 0 },
      { "name": "payment_method", "type": "select", "required": true, "values": ["cash", "transfer", "card", "e_wallet"], "maxSelect": 1 },
      { "name": "paid_at", "type": "date", "required": true },
      { "name": "received_by", "type": "relation", "required": false, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "note", "type": "text", "required": false, "max": 500 }
    ],
    "indexes": ["CREATE INDEX idx_payments_paid_at ON payments (paid_at)", "CREATE INDEX idx_payments_method ON payments (payment_method)"],
    "listRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "viewRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "createRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff'",
    "updateRule": null,
    "deleteRule": null
  },
  {
    "name": "shifts",
    "type": "base",
    "comment": "<- shifts (code UNIQUE MORNING/AFTERNOON/NIGHT; end<start = ca qua ngay chi cho NIGHT). Seed 3 ca sau import.",
    "fields": [
      { "name": "code", "type": "text", "required": true, "unique": true, "max": 20, "comment": "MORNING|AFTERNOON|NIGHT" },
      { "name": "name", "type": "text", "required": true, "min": 1, "max": 100 },
      { "name": "start_time", "type": "text", "required": true, "max": 5, "comment": "HH:MM" },
      { "name": "end_time", "type": "text", "required": true, "max": 5, "comment": "HH:MM" },
      { "name": "is_active", "type": "bool", "required": false }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_shifts_code ON shifts (code)"],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.role = 'admin'",
    "updateRule": "@request.auth.role = 'admin'",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "attendance",
    "type": "base",
    "comment": "<- attendance (UNIQUE user+shift+work_date; work_date = NGAY BAT DAU ca; dem 22:00 24/10 -> work_date 24/10).",
    "fields": [
      { "name": "user", "type": "relation", "required": true, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "shift", "type": "relation", "required": true, "collectionId": "shifts", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "work_date", "type": "date", "required": true },
      { "name": "check_in_at", "type": "date", "required": false },
      { "name": "check_out_at", "type": "date", "required": false },
      { "name": "opening_cash", "type": "number", "required": true, "min": 0 },
      { "name": "closing_cash", "type": "number", "required": false, "min": 0 },
      { "name": "handover_note", "type": "text", "required": false, "max": 500 },
      { "name": "status", "type": "select", "required": true, "values": ["present", "late", "missing"], "maxSelect": 1 }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_att_user_shift_date ON attendance (user, shift, work_date)", "CREATE INDEX idx_att_user_date ON attendance (user, work_date)", "CREATE INDEX idx_att_date ON attendance (work_date)"],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.id != ''",
    "deleteRule": "@request.auth.role = 'admin'"
  },
  {
    "name": "reservations",
    "type": "base",
    "comment": "<- reservations (code R-YYYYMMDD-#### UNIQUE; khung 06:00-22:00, 1-4h, date=today V1; quota<=2 do app dem). MINE-ONLY server-side qua field user.",
    "fields": [
      { "name": "code", "type": "text", "required": true, "unique": true, "max": 30 },
      { "name": "user", "type": "relation", "required": true, "collectionId": "users", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "vehicle", "type": "relation", "required": false, "collectionId": "vehicles", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "license_plate", "type": "text", "required": false, "max": 20 },
      { "name": "customer_phone", "type": "text", "required": false, "max": 20 },
      { "name": "zone", "type": "relation", "required": true, "collectionId": "zones", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "spot", "type": "relation", "required": false, "collectionId": "spots", "cascadeDelete": false, "maxSelect": 1 },
      { "name": "date", "type": "date", "required": true },
      { "name": "start_time", "type": "text", "required": true, "max": 5, "comment": "HH:mm >= 06:00" },
      { "name": "end_time", "type": "text", "required": true, "max": 5, "comment": "HH:mm <= 22:00, end>start, 1-4h" },
      { "name": "status", "type": "select", "required": true, "values": ["pending", "active", "completed", "cancelled", "expired"], "maxSelect": 1 },
      { "name": "expires_at", "type": "date", "required": true }
    ],
    "indexes": ["CREATE UNIQUE INDEX idx_res_code ON reservations (code)", "CREATE INDEX idx_res_user_status_date ON reservations (user, status, date)", "CREATE INDEX idx_res_zone_date_status ON reservations (zone, date, status)", "CREATE INDEX idx_res_status_expires ON reservations (status, expires_at)"],
    "listRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff' || user = @request.auth.id",
    "viewRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff' || user = @request.auth.id",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.role = 'admin' || @request.auth.role = 'staff' || user = @request.auth.id",
    "deleteRule": "@request.auth.role = 'admin'"
  }
]
